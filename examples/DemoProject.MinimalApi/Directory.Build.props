<Project>
  <!-- GUARDRAIL: NuGet audit — direct AND transitive vulnerabilities fail the build.
       Level=low reports every severity. Escalation to error happens via
       TreatWarningsAsErrors (CI build + local Release builds).
       See docs/solutions/nuget-audit-as-error.md -->
  <PropertyGroup>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
</Project>
